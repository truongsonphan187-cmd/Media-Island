<Window x:Class="DynamicIslandMedia.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Island Settings"
        Height="790" Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Toggle button / checkbox style -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="PositionRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#1C1C24"/>
            <Setter Property="BorderBrush" Value="#2D2D3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#52525B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border CornerRadius="16"
            Background="#141419"
            BorderBrush="#2C2C35"
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#242432" Margin="0,0,10,0">
                        <Path Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="#D4D4D8"
                              Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                    </Border>
                    <TextBlock Text="Media Island Settings"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#F4F4F5"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Width="28" Height="28"
                        Background="Transparent"
                        Foreground="#A1A1AA"
                        BorderThickness="0"
                        FontSize="13"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14">
                                <Path Data="M1,1 L9,9 M9,1 L1,9" Width="10" Height="10"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2D2D3A"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Settings Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Screen Position -->
                <TextBlock Text="Screen Position:"
                           Foreground="#A1A1AA"
                           FontSize="12"
                           FontWeight="Medium"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="BottomPositionRadio"
                                 Grid.Column="0"
                                 Content="Bottom"
                                 GroupName="IslandPositionGroup"
                                 Style="{StaticResource PositionRadioButtonStyle}"
                                 Margin="0,0,4,0"
                                 Checked="PositionRadio_Checked"/>
                    <RadioButton x:Name="TopPositionRadio"
                                 Grid.Column="1"
                                 Content="Top"
                                 GroupName="IslandPositionGroup"
                                 Style="{StaticResource PositionRadioButtonStyle}"
                                 Margin="4,0,0,0"
                                 Checked="PositionRadio_Checked"/>
                </Grid>

                <!-- Edge Distance -->
                <TextBlock x:Name="DistanceLabel"
                           Text="{Binding DistanceLabelText}"
                           Foreground="#A1A1AA"
                           FontSize="12"
                           FontWeight="Medium"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="BottomMarginSlider"
                            Minimum="0" Maximum="80"
                            TickFrequency="1" IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"
                            Style="{StaticResource ModernSliderStyle}"
                            ValueChanged="BottomMarginSlider_ValueChanged"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ElementName=BottomMarginSlider, Path=Value, StringFormat='{}{0:0.#} px'}"
                               Foreground="#E4E4E7"
                               FontWeight="SemiBold"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <Separator Background="#262630" Margin="0,4,0,14"/>

                <!-- Appearance -->
                <TextBlock Text="Appearance:"
                           Foreground="#A1A1AA"
                           FontSize="12"
                           FontWeight="Medium"
                           Margin="0,0,0,6"/>
<CheckBox x:Name="EnableGradientCheckBox"
                          Content="Enable ambient gradient"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          Margin="0,0,0,10"/>

                <CheckBox x:Name="EnableProgressGlowCheckBox"
                          Content="Enable progress glow"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          Margin="0,0,0,12"/>

                <TextBlock Text="Compact pill opacity:"
                           Foreground="#A1A1AA" FontSize="12" FontWeight="Medium" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                    <Slider x:Name="CompactOpacitySlider" Minimum="0" Maximum="100"
                            TickFrequency="1" VerticalAlignment="Center"
                            Style="{StaticResource ModernSliderStyle}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=CompactOpacitySlider, Path=Value, StringFormat='{}{0:0}%'}"
                               Foreground="#E4E4E7" FontWeight="SemiBold" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="Expanded card opacity:"
                           Foreground="#A1A1AA" FontSize="12" FontWeight="Medium" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                    <Slider x:Name="ExpandedOpacitySlider" Minimum="0" Maximum="100"
                            TickFrequency="1" VerticalAlignment="Center"
                            Style="{StaticResource ModernSliderStyle}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=ExpandedOpacitySlider, Path=Value, StringFormat='{}{0:0}%'}"
                               Foreground="#E4E4E7" FontWeight="SemiBold" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Separator Background="#262630" Margin="0,4,0,14"/>

                <!-- Auto-Expand on hover -->
                <CheckBox x:Name="AutoExpandCheckBox"
                          Content="Expand automatically on mouse hover"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          Margin="0,0,0,12"/>

                <!-- Auto-Hide when idle (hidden per user requirement) -->
                <CheckBox x:Name="AutoHideCheckBox"
                          Content="Auto-hide island completely when idle (no media)"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          Margin="0,0,0,12"
                          Visibility="Collapsed"/>

                <!-- Behavior: hover dwell timings -->
                <TextBlock Text="Hover expand delay:" Foreground="#A1A1AA" FontSize="12"
                           FontWeight="Medium" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <Slider x:Name="HoverExpandDelaySlider" Minimum="0" Maximum="1000"
                            TickFrequency="25" IsSnapToTickEnabled="True"
                            Style="{StaticResource ModernSliderStyle}"/>
                    <TextBlock Grid.Column="1" Foreground="#E4E4E7" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding ElementName=HoverExpandDelaySlider, Path=Value, StringFormat='{}{0:0} ms'}"/>
                </Grid>
                <TextBlock Text="Hover collapse delay:" Foreground="#A1A1AA" FontSize="12"
                           FontWeight="Medium" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <Slider x:Name="HoverCollapseDelaySlider" Minimum="0" Maximum="1500"
                            TickFrequency="25" IsSnapToTickEnabled="True"
                            Style="{StaticResource ModernSliderStyle}"/>
                    <TextBlock Grid.Column="1" Foreground="#E4E4E7" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding ElementName=HoverCollapseDelaySlider, Path=Value, StringFormat='{}{0:0} ms'}"/>
                </Grid>

                <!-- Start with Windows -->
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="Launch on Windows startup"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          Margin="0,0,0,12"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Reset"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ResetButton_Click"/>

                <Button Grid.Column="2"
                        Content="Apply &amp; Close"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ApplyButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
