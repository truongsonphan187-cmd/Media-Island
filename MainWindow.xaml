<Window
	x:Class="DynamicIslandMedia.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:DynamicIslandMedia.ViewModels"
	Title="Media Island"
	Width="500"
	Height="300"
	WindowStyle="None"
	AllowsTransparency="True"
	Background="#00FFFFFF"
	Topmost="True"
	ShowInTaskbar="False"
	ResizeMode="NoResize"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	WindowStartupLocation="Manual" xmlns:dynamicislandmedia="clr-namespace:DynamicIslandMedia">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type Button}"
				x:Key="MediaControlButtonStyle">
				<Setter
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					Property="Foreground"
					Value="#D4D4D8" />
				<Setter
					Property="BorderThickness"
					Value="0" />
				<Setter
					Property="Width"
					Value="32" />
				<Setter
					Property="Height"
					Value="32" />
				<Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Border
								Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="16">
								<ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="border"
										Property="Background"
										Value="#2A2A36" />
									<Setter
										Property="Foreground"
										Value="#FFFFFF" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="border"
										Property="Background"
										Value="#1C1C24" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type Button}"
				x:Key="PlayPauseButtonStyle">
				<Setter
					Property="Background"
					Value="#FFFFFF" />
				<Setter
					Property="Foreground"
					Value="#0F0F12" />
				<Setter
					Property="BorderThickness"
					Value="0" />
				<Setter
					Property="Width"
					Value="32" />
				<Setter
					Property="Height"
					Value="32" />
				<Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Border
								Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="16">
								<ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="border"
										Property="Background"
										Value="#E4E4E7" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="border"
										Property="Background"
										Value="#A1A1AA" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Storyboard
				RepeatBehavior="Forever"
				AutoReverse="True"
				x:Key="WaveAnimation1">
				<DoubleAnimation
					Storyboard.TargetProperty="Height"
					From="4"
					To="14"
					Duration="0:0:0.42" />
			</Storyboard>
			<Storyboard
				RepeatBehavior="Forever"
				AutoReverse="True"
				x:Key="WaveAnimation2">
				<DoubleAnimation
					Storyboard.TargetProperty="Height"
					From="6"
					To="18"
					Duration="0:0:0.32"
					BeginTime="0:0:0.08" />
			</Storyboard>
			<Storyboard
				RepeatBehavior="Forever"
				AutoReverse="True"
				x:Key="WaveAnimation3">
				<DoubleAnimation
					Storyboard.TargetProperty="Height"
					From="3"
					To="16"
					Duration="0:0:0.38"
					BeginTime="0:0:0.15" />
			</Storyboard>
			<Storyboard
				RepeatBehavior="Forever"
				AutoReverse="True"
				x:Key="WaveAnimation4">
				<DoubleAnimation
					Storyboard.TargetProperty="Height"
					From="5"
					To="12"
					Duration="0:0:0.45"
					BeginTime="0:0:0.22" />
			</Storyboard>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		HorizontalAlignment="Center"
		VerticalAlignment="Bottom">
		<Grid
			Name="IslandHitBox"
			Width="240"
			VerticalAlignment="Bottom"
			Margin="0,0,0,16"
			Background="#00000000"
			MouseEnter="IslandHitBox_MouseEnter"
			MouseLeave="IslandHitBox_MouseLeave"
			MouseLeftButtonDown="IslandHitBox_MouseLeftButtonDown">
			<Border
				Height="40"
				VerticalAlignment="Bottom"
				Background="#00000000"
				Cursor="Hand" />
			<Border
				Name="ShadowBorder"
				Width="240"
				Height="38"
				CornerRadius="19"
				Background="#0D0D11"
				VerticalAlignment="Bottom"
				Margin="0,0,0,40"
				IsHitTestVisible="False">
				<UIElement.Effect>
					<DropShadowEffect
						BlurRadius="24"
						ShadowDepth="3"
						Opacity="0.45"
						Color="#000000" />
				</UIElement.Effect>
			</Border>
			<Border
				Name="IslandBorder"
				Width="240"
				Height="38"
				CornerRadius="19"
				Background="#0D0D11"
				BorderBrush="#2A2A35"
				BorderThickness="1"
				VerticalAlignment="Bottom"
				Margin="0,0,0,40"
				Cursor="Hand"
				MouseRightButtonDown="IslandBorder_MouseRightButtonDown">
				<Grid>
					<Grid
						Name="CompactContentGrid"
						Height="38"
						VerticalAlignment="Center"
						Opacity="1.0"
						Margin="6,0,10,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<Border
							Grid.Column="0"
							Width="26"
							Height="26"
							CornerRadius="8"
							ClipToBounds="True"
							Background="#1E1E26"
							BorderBrush="#383848"
							BorderThickness="1"
							VerticalAlignment="Center">
							<Image
								Stretch="UniformToFill"
								RenderOptions.BitmapScalingMode="HighQuality"
								Source="{Binding AlbumArt}" />
						</Border>
						<StackPanel
							Grid.Column="1"
							Margin="8,0,8,0"
							VerticalAlignment="Center">
							<TextBlock
								Foreground="#F4F4F5"
								FontSize="11.5"
								FontWeight="SemiBold"
								TextTrimming="CharacterEllipsis"
								Text="{Binding TrackTitle}" />
							<TextBlock
								Foreground="#A1A1AA"
								FontSize="9.5"
								TextTrimming="CharacterEllipsis"
								Margin="0,1,0,0"
								Text="{Binding ArtistName}" />
						</StackPanel>
						<StackPanel
							Grid.Column="2"
							Orientation="Horizontal"
							VerticalAlignment="Center"
							Height="20">
							<Border
								Name="WaveBar1"
								Width="2.5"
								Height="8"
								CornerRadius="1.2"
								Background="#60A5FA"
								Margin="1.5,0"
								VerticalAlignment="Center" />
							<Border
								Name="WaveBar2"
								Width="2.5"
								Height="14"
								CornerRadius="1.2"
								Background="#818CF8"
								Margin="1.5,0"
								VerticalAlignment="Center" />
							<Border
								Name="WaveBar3"
								Width="2.5"
								Height="6"
								CornerRadius="1.2"
								Background="#A78BFA"
								Margin="1.5,0"
								VerticalAlignment="Center" />
							<Border
								Name="WaveBar4"
								Width="2.5"
								Height="10"
								CornerRadius="1.2"
								Background="#C084FC"
								Margin="1.5,0"
								VerticalAlignment="Center" />
						</StackPanel>
					</Grid>
					<Grid
						Name="ExpandedContentGrid"
						Opacity="0.0"
						Visibility="Collapsed"
						Margin="12,10,12,10">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="*" />
						</Grid.RowDefinitions>
						<Grid
							Row="0"
							Margin="0,0,0,4"
							VerticalAlignment="Top">
							<Border
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Background="#1A1A22"
								BorderBrush="#2D2D3A"
								BorderThickness="1"
								CornerRadius="10"
								Padding="8,3">
								<StackPanel
									Orientation="Horizontal"
									VerticalAlignment="Center">
									<Ellipse
										Width="6"
										Height="6"
										Margin="0,0,6,0">
										<FrameworkElement.Style>
											<Style
												TargetType="{x:Type Ellipse}">
												<Setter
													Property="Fill"
													Value="#10B981" />
												<Style.Triggers>
													<DataTrigger
														Value="False"
														Binding="{Binding IsPlaying}">
														<Setter
															Property="Fill"
															Value="#EAB308" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</FrameworkElement.Style>
									</Ellipse>
									<TextBlock
										FontSize="10.5"
										FontWeight="SemiBold"
										Foreground="#D4D4D8"
										TextTrimming="CharacterEllipsis"
										MaxWidth="180"
										Text="{Binding AppName}" />
								</StackPanel>
							</Border>
							<StackPanel
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Orientation="Horizontal">
								<Button
									Name="PinButton"
									Width="24"
									Height="24"
									Margin="0,0,4,0"
									ToolTip="Pin island expanded"
									Command="{Binding TogglePinCommand}">
									<FrameworkElement.Style>
										<Style
											BasedOn="{StaticResource MediaControlButtonStyle}"
											TargetType="{x:Type Button}">
											<Setter
												Property="Foreground"
												Value="#71717A" />
											<Style.Triggers>
												<DataTrigger
													Value="True"
													Binding="{Binding IsPinned}">
													<Setter
														Property="Foreground"
														Value="#60A5FA" />
													<Setter
														Property="Background"
														Value="#1E293B" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</FrameworkElement.Style>
									<TextBlock
										Text="📌"
										FontSize="11"
										HorizontalAlignment="Center"
										VerticalAlignment="Center" />
								</Button>
								<Button
									Width="24"
									Height="24"
									Style="{StaticResource MediaControlButtonStyle}"
									ToolTip="Collapse to pill"
									Command="{Binding CollapseCommand}">
									<TextBlock
										Text="⌃"
										FontSize="14"
										FontWeight="Bold"
										Margin="0,-2,0,0" />
								</Button>
							</StackPanel>
						</Grid>
						<Grid
							Row="1"
							VerticalAlignment="Center">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<Border
								Grid.Column="0"
								Width="74"
								Height="74"
								CornerRadius="12"
								ClipToBounds="True"
								Background="#1E1E26"
								BorderBrush="#353545"
								BorderThickness="1"
								VerticalAlignment="Center"
								Margin="0,0,12,0">
								<UIElement.Effect>
									<DropShadowEffect
										BlurRadius="12"
										ShadowDepth="2"
										Opacity="0.4"
										Color="#000000" />
								</UIElement.Effect>
								<Image
									Stretch="UniformToFill"
									RenderOptions.BitmapScalingMode="HighQuality"
									Source="{Binding AlbumArt}" />
							</Border>
							<Grid
								Column="1"
								VerticalAlignment="Center">
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
									<RowDefinition
										Height="Auto" />
									<RowDefinition
										Height="Auto" />
								</Grid.RowDefinitions>
								<StackPanel
									Grid.Row="0"
									Margin="0,0,0,4">
									<TextBlock
										Foreground="#FFFFFF"
										FontSize="12.5"
										FontWeight="Bold"
										TextTrimming="CharacterEllipsis"
										VerticalAlignment="Top"
										LineStackingStrategy="BlockLineHeight"
										Padding="0,2,0,0"
										Margin="0,0,0,1"
										Text="{Binding TrackTitle}" />
									<TextBlock
										Foreground="#A1A1AA"
										FontSize="10.5"
										TextTrimming="CharacterEllipsis"
										Text="{Binding ArtistName}" />
								</StackPanel>
								<Grid
									Row="1"
									Margin="0,3,0,4"
									Cursor="Hand"
									MouseLeftButtonDown="ProgressBar_MouseLeftButtonDown">
									<Grid.RowDefinitions>
										<RowDefinition
											Height="Auto" />
										<RowDefinition
											Height="Auto" />
									</Grid.RowDefinitions>
									<Border
										Name="ProgressTrackBorder"
										Grid.Row="0"
										Height="4"
										CornerRadius="2"
										Background="#262632"
										SizeChanged="ProgressTrackBorder_SizeChanged">
										<Border
											Name="ProgressFillBorder"
											HorizontalAlignment="Left"
											CornerRadius="2"
											Width="0">
											<Border.Background>
												<LinearGradientBrush
													StartPoint="0,0"
													EndPoint="1,0">
													<GradientStop
														Color="#60A5FA"
														Offset="0.0" />
													<GradientStop
														Color="#A78BFA"
														Offset="1.0" />
												</LinearGradientBrush>
											</Border.Background>
										</Border>
									</Border>
									<Grid
										Row="1"
										Margin="0,3,0,0">
										<TextBlock
											Foreground="#71717A"
											FontSize="9"
											HorizontalAlignment="Left"
											Text="{Binding PositionString}" />
										<TextBlock
											Foreground="#71717A"
											FontSize="9"
											HorizontalAlignment="Right"
											Text="{Binding DurationString}" />
									</Grid>
								</Grid>
								<Grid
									Row="2"
									HorizontalAlignment="Center"
									VerticalAlignment="Center">
									<StackPanel
										Orientation="Horizontal"
										HorizontalAlignment="Center"
										VerticalAlignment="Center">
										<Button
											Style="{StaticResource MediaControlButtonStyle}"
											ToolTip="Previous track"
											VerticalAlignment="Center"
											Margin="0,0,16,0"
											Command="{Binding PreviousCommand}">
											<Path
												Data="M11,3 L3,9.5 L11,16 M18,3 L10,9.5 L18,16"
												Stretch="Uniform"
												Width="13"
												Height="13"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												StrokeThickness="2"
												StrokeStartLineCap="Round"
												StrokeEndLineCap="Round"
												Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
										</Button>
										<Button
											Style="{StaticResource PlayPauseButtonStyle}"
											ToolTip="Play / Pause"
											VerticalAlignment="Center"
											Margin="0,0,16,0"
											Command="{Binding PlayPauseCommand}">
											<Grid
												Width="32"
												Height="32"
												HorizontalAlignment="Center"
												VerticalAlignment="Center">
												<Path
													Name="PlayIcon"
													Data="M4,2 L16,9.5 L4,17"
													Fill="#0F0F12"
													Stretch="Uniform"
													Width="12"
													Height="12"
													HorizontalAlignment="Center"
													VerticalAlignment="Center"
													Margin="2,0,0,0">
													<FrameworkElement.Style>
														<Style
															TargetType="{x:Type Path}">
															<Setter
																Property="Visibility"
																Value="Collapsed" />
															<Style.Triggers>
																<DataTrigger
																	Value="False"
																	Binding="{Binding IsPlaying}">
																	<Setter
																		Property="Visibility"
																		Value="Visible" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</FrameworkElement.Style>
												</Path>
												<Path
													Name="PauseIcon"
													Data="M3,2 L7,2 L7,16 L3,16 M11,2 L15,2 L15,16 L11,16"
													Fill="#0F0F12"
													Stretch="Uniform"
													Width="12"
													Height="12"
													HorizontalAlignment="Center"
													VerticalAlignment="Center">
													<FrameworkElement.Style>
														<Style
															TargetType="{x:Type Path}">
															<Setter
																Property="Visibility"
																Value="Collapsed" />
															<Style.Triggers>
																<DataTrigger
																	Value="True"
																	Binding="{Binding IsPlaying}">
																	<Setter
																		Property="Visibility"
																		Value="Visible" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</FrameworkElement.Style>
												</Path>
											</Grid>
										</Button>
										<Button
											Style="{StaticResource MediaControlButtonStyle}"
											ToolTip="Next track"
											VerticalAlignment="Center"
											Command="{Binding NextCommand}">
											<Path
												Data="M3,3 L11,9.5 L3,16 M10,3 L18,9.5 L10,16"
												Stretch="Uniform"
												Width="13"
												Height="13"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												StrokeThickness="2"
												StrokeStartLineCap="Round"
												StrokeEndLineCap="Round"
												Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
										</Button>
									</StackPanel>
								</Grid>
							</Grid>
						</Grid>
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>
