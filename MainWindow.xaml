<Window
	x:Class="DynamicIslandMedia.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:DynamicIslandMedia.ViewModels" xmlns:controls="clr-namespace:DynamicIslandMedia.Controls"
	Title="Media Island"
	Width="500"
	Height="300"
	WindowStyle="None"
	AllowsTransparency="True"
	Background="#00FFFFFF"
	Topmost="True"
	ShowInTaskbar="False"
	ResizeMode="NoResize"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	WindowStartupLocation="Manual" xmlns:dynamicislandmedia="clr-namespace:DynamicIslandMedia">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type Button}"
				x:Key="MediaControlButtonStyle">
				<Setter
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					Property="Foreground"
					Value="#D4D4D8" />
				<Setter
					Property="BorderThickness"
					Value="0" />
				<Setter
					Property="Width"
					Value="32" />
				<Setter
					Property="Height"
					Value="32" />
				<Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Border
								Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="16">
								<ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="border"
										Property="Background"
										Value="#2A2A36" />
									<Setter
										Property="Foreground"
										Value="#FFFFFF" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="border"
										Property="Background"
										Value="#1C1C24" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type Button}"
				x:Key="PlayPauseButtonStyle">
				<Setter
					Property="Background"
					Value="#FFFFFF" />
				<Setter
					Property="Foreground"
					Value="#0F0F12" />
				<Setter
					Property="BorderThickness"
					Value="0" />
				<Setter
					Property="Width"
					Value="32" />
				<Setter
					Property="Height"
					Value="32" />
				<Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Border
								Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="16">
								<ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="border"
										Property="Background"
										Value="#E4E4E7" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="border"
										Property="Background"
										Value="#A1A1AA" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="IslandRootGrid"
		HorizontalAlignment="Center"
		VerticalAlignment="Bottom">
		<Grid
			Name="IslandHitBox"
			Width="240"
			VerticalAlignment="Bottom"
			Margin="0,0,0,16"
			Background="#00000000"
			MouseEnter="IslandHitBox_MouseEnter"
			MouseLeave="IslandHitBox_MouseLeave"
			MouseLeftButtonDown="IslandHitBox_MouseLeftButtonDown">
			<Border
				Name="BottomHoverBuffer"
				Height="40"
				VerticalAlignment="Bottom"
				Background="#00000000"
				Cursor="Hand" />
			<Border
				Name="ShadowBorder"
				Width="240"
				Height="38"
				CornerRadius="19"
				Background="#B30D0D11"
				VerticalAlignment="Bottom"
				Margin="0,0,0,40"
				IsHitTestVisible="False">
				<UIElement.Effect>
					<DropShadowEffect
						BlurRadius="24"
						ShadowDepth="3"
						Opacity="0.45"
						Color="#000000" />
				</UIElement.Effect>
			</Border>
			<Border
				Name="IslandBorder"
				Width="240"
				Height="38"
				CornerRadius="19"
				Background="#FF17181C"
				BorderBrush="#2A2A35"
				BorderThickness="1"
				VerticalAlignment="Bottom"
				Margin="0,0,0,40"
				Cursor="Hand"
				MouseRightButtonDown="IslandBorder_MouseRightButtonDown">
				<Grid>
                    <!-- Ambient glow (expanded only; compact pill receives no colour).
                         Pixels come from Rendering/AmbientGlowRenderer at device resolution. -->
                    <Border Name="AmbientGradientLayer"
                            Height="155" Margin="1,0,1,1"
                            VerticalAlignment="Bottom"
                            CornerRadius="0,0,20,20"
                            SizeChanged="AmbientGradientLayer_SizeChanged"
                            Opacity="0" IsHitTestVisible="False">
                        <Image x:Name="AmbientWaveImage"
                               Stretch="Fill"
                               SnapsToDevicePixels="False"
                               IsHitTestVisible="False" />
                    </Border>
					<Grid
						Name="CompactContentGrid"
						Height="38"
						VerticalAlignment="Center"
						Opacity="1.0"
						Margin="6,0,10,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<Border
							Grid.Column="0"
							Width="26"
							Height="26"
							CornerRadius="8"
							ClipToBounds="True"
							Background="#1E1E26"
							BorderBrush="#383848"
							BorderThickness="1"
							VerticalAlignment="Center">
                            <controls:AlbumCover Width="24" Height="24" CornerRadius="7"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Source="{Binding AlbumArt}"/>
						</Border>
						<StackPanel
							Grid.Column="1"
							Margin="8,0,8,0"
							VerticalAlignment="Center">
							<TextBlock
								Foreground="#F4F4F5"
								FontSize="11.5"
								FontWeight="SemiBold"
								TextTrimming="CharacterEllipsis"
								Text="{Binding TrackTitle}" />
							<TextBlock
								Foreground="#A1A1AA"
								FontSize="9.5"
								TextTrimming="CharacterEllipsis"
								Margin="0,1,0,0"
								Text="{Binding ArtistName}" />
						</StackPanel>
						<StackPanel
							Grid.Column="2"
							Orientation="Horizontal"
							VerticalAlignment="Center"
							UseLayoutRounding="False"
							SnapsToDevicePixels="False"
							Height="20">
							<Border
								Name="WaveBar1"
								Width="3"
								Height="3"
								CornerRadius="1.5"
								Background="#60A5FA"
								Margin="1.5,0"
								VerticalAlignment="Center">
								<UIElement.Effect>
									<DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.65" Color="#60A5FA" />
								</UIElement.Effect>
							</Border>
							<Border
								Name="WaveBar2"
								Width="3"
								Height="3"
								CornerRadius="1.5"
								Background="#818CF8"
								Margin="1.5,0"
								VerticalAlignment="Center">
								<UIElement.Effect>
									<DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.65" Color="#818CF8" />
								</UIElement.Effect>
							</Border>
							<Border
								Name="WaveBar3"
								Width="3"
								Height="3"
								CornerRadius="1.5"
								Background="#A78BFA"
								Margin="1.5,0"
								VerticalAlignment="Center">
								<UIElement.Effect>
									<DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.65" Color="#A78BFA" />
								</UIElement.Effect>
							</Border>
							<Border
								Name="WaveBar4"
								Width="3"
								Height="3"
								CornerRadius="1.5"
								Background="#C084FC"
								Margin="1.5,0"
								VerticalAlignment="Center">
								<UIElement.Effect>
									<DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.65" Color="#C084FC" />
								</UIElement.Effect>
							</Border>
						</StackPanel>
					</Grid>
					<Grid
						Name="ExpandedContentGrid"
						Opacity="0.0"
						Visibility="Collapsed"
						Margin="12,10,12,10">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="*" />
						</Grid.RowDefinitions>
						<Grid
							Row="0"
							Margin="0,0,0,4"
							VerticalAlignment="Top">
							<Border
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Background="#1A1A22"
								BorderBrush="#2D2D3A"
								BorderThickness="1"
								CornerRadius="10"
								Padding="8,3">
								<StackPanel
									Orientation="Horizontal"
									VerticalAlignment="Center">
									<Ellipse
										Width="6"
										Height="6"
										Margin="0,0,6,0">
										<FrameworkElement.Style>
											<Style
												TargetType="{x:Type Ellipse}">
												<Setter
													Property="Fill"
													Value="#10B981" />
												<Style.Triggers>
													<DataTrigger
														Value="False"
														Binding="{Binding IsPlaying}">
														<Setter
															Property="Fill"
															Value="#EAB308" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</FrameworkElement.Style>
									</Ellipse>
									<TextBlock
										FontSize="10.5"
										FontWeight="SemiBold"
										Foreground="#D4D4D8"
										TextTrimming="CharacterEllipsis"
										MaxWidth="180"
										Text="{Binding AppName}" />
								</StackPanel>
							</Border>
							<StackPanel
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Orientation="Horizontal">
								<Button
									Name="PinButton"
									Width="24"
									Height="24"
									Margin="0,0,4,0"
									ToolTip="{Binding PinButtonToolTip}"
									Command="{Binding TogglePinCommand}">
									<FrameworkElement.Style>
										<Style
											BasedOn="{StaticResource MediaControlButtonStyle}"
											TargetType="{x:Type Button}">
											<Setter
												Property="Foreground"
												Value="#71717A" />
											<Style.Triggers>
												<DataTrigger
													Value="True"
													Binding="{Binding IsPinned}">
													<Setter
														Property="Foreground"
														Value="#60A5FA" />
													<Setter
														Property="Background"
														Value="#1E293B" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</FrameworkElement.Style>
									<Path
										Data="M16,12 V4 H17 V2 H7 V4 H8 V12 L6,14 V16 H11.2 V22 H12.8 V16 H18 V14 Z"
										Stretch="Uniform"
										Width="11"
										Height="11"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
								</Button>
								<Button
									Width="24"
									Height="24"
									Style="{StaticResource MediaControlButtonStyle}"
									ToolTip="Collapse to pill"
									Command="{Binding CollapseCommand}">
									<Path
										Data="M3,10 L8,5 L13,10"
										Width="16"
										Height="15"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										StrokeThickness="1.8"
										StrokeStartLineCap="Round"
										StrokeEndLineCap="Round"
										StrokeLineJoin="Round"
										Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
								</Button>
							</StackPanel>
						</Grid>
						<Grid
							Row="1"
							VerticalAlignment="Center">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<Border
								Grid.Column="0"
								Width="74"
								Height="74"
								CornerRadius="12"
								ClipToBounds="True"
								Background="#1E1E26"
								BorderBrush="#353545"
								BorderThickness="1"
								VerticalAlignment="Center"
								Margin="0,0,12,0">
								<UIElement.Effect>
									<DropShadowEffect
										BlurRadius="12"
										ShadowDepth="2"
										Opacity="0.4"
										Color="#000000" />
								</UIElement.Effect>
                                <controls:AlbumCover Width="72" Height="72" CornerRadius="11"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Source="{Binding AlbumArt}"/>
							</Border>
							<Grid
								Column="1"
								VerticalAlignment="Center">
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
									<RowDefinition
										Height="Auto" />
									<RowDefinition
										Height="Auto" />
								</Grid.RowDefinitions>
								<StackPanel
									Grid.Row="0"
									Margin="0,0,0,4">
									<TextBlock
										Foreground="#FFFFFF"
										FontSize="12.5"
										FontWeight="Bold"
										TextTrimming="CharacterEllipsis"
										VerticalAlignment="Top"
										LineStackingStrategy="BlockLineHeight"
										Padding="0,2,0,0"
										Margin="0,0,0,1"
										Text="{Binding TrackTitle}" />
									<TextBlock
										Foreground="#A1A1AA"
										FontSize="10.5"
										TextTrimming="CharacterEllipsis"
										Text="{Binding ArtistName}" />
								</StackPanel>
								<Grid
									Row="1"
									Margin="0,3,0,4"
									Name="ProgressScrubArea"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    PreviewMouseLeftButtonDown="ProgressScrubArea_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="ProgressScrubArea_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="ProgressScrubArea_PreviewMouseLeftButtonUp"
                                    LostMouseCapture="ProgressScrubArea_LostMouseCapture">
									<Grid.RowDefinitions>
										<RowDefinition
											Height="Auto" />
										<RowDefinition
											Height="Auto" />
									</Grid.RowDefinitions>
																		<!-- Layered track: glow is outside the 4px progress line. -->
                                    <Grid Grid.Row="0" Height="14">
                                        <Border Name="ProgressTrackBorder" Height="4" CornerRadius="2"
                                                VerticalAlignment="Center" Background="#454552"
                                                SizeChanged="ProgressTrackBorder_SizeChanged" />
                                        <!-- Glow stays precisely on the fill. Its gradient starts transparent
                                             and reaches full strength at the current playback head. -->
                                        <Border Name="ProgressGlowBorder" Width="0" Height="7" CornerRadius="3.5"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Opacity="1.0" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#0066AFFF" Offset="0" />
                                                    <GradientStop Color="#1470B9FF" Offset="0.42" />
                                                    <GradientStop Color="#998DADFF" Offset="0.82" />
                                                    <GradientStop Color="#FFF2F4FF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect><BlurEffect Radius="12" /></Border.Effect>
                                        </Border>
                                        <!-- Actual filled track, independently brightest at playback head. -->
                                        <Border Name="ProgressFillBorder" Width="0" Height="4" CornerRadius="2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#4971A3" Offset="0" />
                                                    <GradientStop Color="#668CD7" Offset="0.45" />
                                                    <GradientStop Color="#9FB2FF" Offset="0.83" />
                                                    <GradientStop Color="#F5F7FF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <Grid
										Row="1"
										Margin="0,3,0,0">
										<TextBlock
											Foreground="#71717A"
											FontSize="9"
											HorizontalAlignment="Left"
											Text="{Binding PositionString}" />
										<TextBlock
											Foreground="#71717A"
											FontSize="9"
											HorizontalAlignment="Right"
											Text="{Binding DurationString}" />
									</Grid>
								</Grid>
								<Grid
									Row="2"
									HorizontalAlignment="Center"
									VerticalAlignment="Center">
									<StackPanel
										Orientation="Horizontal"
										HorizontalAlignment="Center"
										VerticalAlignment="Center">
										<Button
											Style="{StaticResource MediaControlButtonStyle}"
											ToolTip="Previous track"
											VerticalAlignment="Center"
											Margin="0,0,16,0"
											Command="{Binding PreviousCommand}">
											<Path
												Data="M11,3 L3,9.5 L11,16 M18,3 L10,9.5 L18,16"
												Stretch="Uniform"
												Width="13"
												Height="13"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												StrokeThickness="2"
												StrokeStartLineCap="Round"
												StrokeEndLineCap="Round"
												StrokeLineJoin="Round"
												Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
										</Button>
										<Button
											Style="{StaticResource PlayPauseButtonStyle}"
											ToolTip="Play / Pause"
											VerticalAlignment="Center"
											Margin="0,0,16,0"
											Command="{Binding PlayPauseCommand}">
											<Grid
												Width="32"
												Height="32"
												HorizontalAlignment="Center"
												VerticalAlignment="Center">
												<Path
													Name="PlayIcon"
													Data="M4,2 L16,9.5 L4,17 Z"
													Fill="#0F0F12"
													Stroke="#0F0F12"
													StrokeThickness="2.4"
													StrokeLineJoin="Round"
													Stretch="Uniform"
													Width="12"
													Height="12"
													HorizontalAlignment="Center"
													VerticalAlignment="Center"
													Margin="2,0,0,0">
													<FrameworkElement.Style>
														<Style
															TargetType="{x:Type Path}">
															<Setter
																Property="Visibility"
																Value="Collapsed" />
															<Style.Triggers>
																<DataTrigger
																	Value="False"
																	Binding="{Binding IsPlaying}">
																	<Setter
																		Property="Visibility"
																		Value="Visible" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</FrameworkElement.Style>
												</Path>
												<Path
													Name="PauseIcon"
													Data="M3.5,2.5 L6.5,2.5 L6.5,15.5 L3.5,15.5 Z M11.5,2.5 L14.5,2.5 L14.5,15.5 L11.5,15.5 Z"
													Fill="#0F0F12"
													Stroke="#0F0F12"
													StrokeThickness="1.6"
													StrokeLineJoin="Round"
													Stretch="Uniform"
													Width="12"
													Height="12"
													HorizontalAlignment="Center"
													VerticalAlignment="Center">
													<FrameworkElement.Style>
														<Style
															TargetType="{x:Type Path}">
															<Setter
																Property="Visibility"
																Value="Collapsed" />
															<Style.Triggers>
																<DataTrigger
																	Value="True"
																	Binding="{Binding IsPlaying}">
																	<Setter
																		Property="Visibility"
																		Value="Visible" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</FrameworkElement.Style>
												</Path>
											</Grid>
										</Button>
										<Button
											Style="{StaticResource MediaControlButtonStyle}"
											ToolTip="Next track"
											VerticalAlignment="Center"
											Command="{Binding NextCommand}">
											<Path
												Data="M3,3 L11,9.5 L3,16 M10,3 L18,9.5 L10,16"
												Stretch="Uniform"
												Width="13"
												Height="13"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												StrokeThickness="2"
												StrokeStartLineCap="Round"
												StrokeEndLineCap="Round"
												StrokeLineJoin="Round"
												Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
										</Button>
									</StackPanel>
								</Grid>
							</Grid>
						</Grid>
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>
